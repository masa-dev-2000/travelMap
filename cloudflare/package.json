{
  "name": "travelmap-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir build",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.5.0",
    "miniflare": "^5.20260908.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
